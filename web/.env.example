# BreezeSwap web — Vercel environment variables.
# Copy to .env.local for local development; set the same keys in the Vercel
# project settings for preview and production.
#
# NEXT_PUBLIC_* values are inlined at BUILD time. Changing one in the Vercel
# dashboard has no effect until you redeploy.

# Base URL of the indexer service on Railway, with no trailing slash.
# Without this the app cannot reach the API and every panel falls back to
# clearly-labelled sample data.
NEXT_PUBLIC_INDEXER_URL=https://<your-service>.up.railway.app

# Flare Coston2 JSON-RPC used for contract reads and writes.
NEXT_PUBLIC_COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc

# Chain BreezeSwap is deployed on. Coston2 testnet.
NEXT_PUBLIC_CHAIN_ID=114

# WalletConnect Cloud project id, for the ConnectKit modal. Get your own at
# https://cloud.reown.com — unset simply disables the WalletConnect transport,
# and injected wallets keep working.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<walletconnect-project-id>

# --- Server-only (never NEXT_PUBLIC_, these must not reach the browser) ----

# Must match ADMIN_API_KEY on the indexer. Used only by the server route at
# app/api/admin/audit-log/route.ts, which the admin page reads the audit feed
# through; without it the feed is empty.
ADMIN_API_KEY=<same-value-as-the-indexer>

# Optional server-side override of the indexer base URL for that route. Falls
# back to NEXT_PUBLIC_INDEXER_URL.
# INDEXER_URL=https://<your-service>.up.railway.app
