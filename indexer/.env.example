# BreezeSwap indexer — Railway service variables.
# Copy to .env for local development; set the same keys in the Railway dashboard.

# --- Database -------------------------------------------------------------
# Supabase REST, used by the API and the watchers.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Direct Postgres connection. REQUIRED — `pnpm start` runs migrations through
# this before booting, so an unset DATABASE_URL means the deploy will not start
# and the schema will drift behind the code.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres

# TLS for the migration connection. Paste the provider CA (Supabase: Project
# Settings -> Database -> SSL configuration) to verify the host, or set
# DATABASE_SSL_STRICT=true to verify against the system trust store. With
# neither, the connection is encrypted but the host is NOT authenticated and the
# migration runner says so on every boot.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_STRICT=true

# --- Chain ----------------------------------------------------------------
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc

# --- Contracts (Coston2, chain 114) --------------------------------------
FACTORY_ADDRESS=0xe8969c988D4CF26AA9A98B8a95fF93D14E80615A
POSITION_TOKEN_ADDRESS=0x611653F531D6c584801449548728290EbE298d28
MOCK_WEATHER_ORACLE_ADDRESS=0x376b26e7C91AE050E48Aa1Ca7233625EA258A3ab
ACCESS_CONTROL_ADDRESS=0x3788420AB4Ef4D2c2dd22c151fd6CB93d2543853

# Block to backfill from on first boot.
DEPLOYMENT_BLOCK=33693264

# --- Server ---------------------------------------------------------------
# Railway injects PORT; this is the local default.
PORT=3001

# Browser origins allowed to call this API, comma-separated and without a
# trailing slash. localhost:3000 is always allowed. Anything not listed gets no
# CORS headers, so a browser will refuse to read the response.
ALLOWED_ORIGINS=https://<your-app>.vercel.app

# Shared secret for /api/admin/*. Those routes refuse every request until this is
# set, and are never safe to call from browser code — the key would ship in the
# bundle. The web app proxies them through its own server route.
ADMIN_API_KEY=<random-32-byte-hex>

# Per-IP requests per minute across /api (default 120).
# RATE_LIMIT_PER_MINUTE=120
